# ------------------------------------------------------------------
# Telegram
# ------------------------------------------------------------------
# Token from @BotFather (looks like 123456789:AAExampleTokenString)
TELEGRAM_BOT_TOKEN=

# Channel to post to. Use @yourchannel for a public channel,
# or the numeric id (e.g. -1001234567890) for a private one.
TELEGRAM_CHANNEL_ID=

# ------------------------------------------------------------------
# Mode: "webhook" (recommended) or "poll"
# ------------------------------------------------------------------
MODE=webhook

# --- webhook mode ---
# The secret you type into the GitHub webhook form. Any long random string.
GITHUB_WEBHOOK_SECRET=
# Port the server listens on (most hosts set PORT for you).
PORT=8080

# --- poll mode ---
# Your repo as owner/repo, e.g. ayur/myapp
GITHUB_REPO=
# Seconds between checks (default 300)
POLL_INTERVAL=300

# ------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------
# Personal access token - needed for PRIVATE repos and to raise the
# GitHub API rate limit. Leave blank for public repos.
GITHUB_TOKEN=

# Only send APK assets whose filename matches this regex.
# Leave blank to send the first *.apk found.
ASSET_FILTER=

# Post the changelog as its own message in addition to the file caption.
SEND_CHANGELOG=true

# Forward pre-releases too (GitHub tags those with a different event action).
# Set to false if you only want full releases posted to the channel.
INCLUDE_PRERELEASES=true
